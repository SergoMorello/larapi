{
  "name": "larapi",
  "version": "0.2.47",
  "description": "API client for laravel",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "jest",
    "build": "tsup",
    "prepublishOnly": "npm test && npm run build"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "transform": {
      "^.+\\.ts?$": "ts-jest",
      "^.+\\.[t|j]sx?$": "babel-jest"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergoMorello/larapi.git"
  },
  "keywords": [
    "api",
    "laravel",
    "cache",
    "events"
  ],
  "author": "Sergei Serov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SergoMorello/larapi/issues"
  },
  "homepage": "https://github.com/SergoMorello/larapi#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-typescript": "^7.22.5",
    "@types/jest": "^29.4.3",
    "babel-jest": "^29.4.3",
    "jest": "^29.4.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "easy-event-emitter": "^1.2.2",
    "md5": "^2.3.0"
  }
}
